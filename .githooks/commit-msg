#!/bin/sh

subject=$(head -n1 "$1")

case "$subject" in
	("Merge "*|"Revert "*) exit 0;;
esac

if ! echo "$subject" | grep -qE '^(feat|fix|refactor|test|docs|perf|ci|chore)(\([^)]+\))?: .+$'; then
	cat >&2 <<EOF
Invalid commit message: "$subject"

Expected: <type>(<optional scope>): <description>
Types:    feat, fix, refactor, perf, test, docs, ci, chore
Example:  feat(api): add order endpoint
EOF
	exit 1
fi

exit 0
